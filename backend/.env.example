# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/myapp?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_SECRET_REFRESH=your_refresh_secret_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (https://redis.io) - high-performance cache
# Set REDIS_ENABLED=false to disable caching (server will still work)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Resend (https://resend.com) - optional email service
# Leave empty to log emails to console (development mode)
RESEND_API_KEY=re_fGqmj6fQ_7Qj6gdYHLxLACsFzrWEZBzbN
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Social Media